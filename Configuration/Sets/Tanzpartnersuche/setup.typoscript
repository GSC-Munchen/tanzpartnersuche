page = PAGE
page {
    includeCSS {
        custom_theme = EXT:tanzpartnersuche/Resources/Public/Css/basic.css
    }
}

plugin.tx_tanzpartnersuche.settings {
    sessionTimeoutMinutes = {$tanzpartnersuche.sessionTimeoutMinutes}
    surveyRecipient = {$tanzpartnersuche.surveyRecipient}
    impressumUrl = {$tanzpartnersuche.impressumUrl}
    verificationValidityMinutes = {$tanzpartnersuche.verificationValidityMinutes}
    resetValidityMinutes = {$tanzpartnersuche.resetValidityMinutes}
}